{
  "rewrites": [
    {
      "source": "/produits/:slug",
      "destination": "/pages/produits/:slug.html"
    },
    {
      "source": "/guides/:g",
      "destination": "/pages/guides/:g.html"
    },
    {
      "source": "/collections/:c",
      "destination": "/pages/collections/:c.html"
    },
    {
      "source": "/:page(carreaux|coffrets|sur-mesure|carte-cadeau|projet-specifique|guides|notre-histoire|faq|contact|mentions-legales|cgv|livraison-retours|confidentialite|merci|panier)",
      "destination": "/pages/:page.html"
    }
  ],
  "redirects": [
    {
      "source": "/collections/les-embiez",
      "destination": "/produits/les-embiez",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(data|scripts)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noai"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}