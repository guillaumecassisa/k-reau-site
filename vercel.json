{
  "rewrites": [
    {
      "source": "/produits/:slug",
      "destination": "/pages/produits/:slug.html"
    },
    {
      "source": "/collections/:c",
      "destination": "/pages/collections/:c.html"
    },
    {
      "source": "/:page(carreaux|notre-histoire|faq|contact|mentions-legales|cgv|livraison-retours|confidentialite|merci|panier|avant-lancement)",
      "destination": "/pages/:page.html"
    }
  ],
  "redirects": [
    {
      "source": "/collections/les-embiez",
      "destination": "/produits/les-embiez",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}